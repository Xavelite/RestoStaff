{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/hooks.client.ts",
    "src/service-worker.ts",
    "src/routes/**/+*.{ts,svelte}",
    "scripts/*.mjs",
    "supabase/functions/*/index.ts",
    "supabase/seed/*.ts",
    "tests/*.test.mjs"
  ],
  "ignore": [
    "src/lib/supabase/database.types.ts",
    "src/lib/tour/**",
    "src/lib/payroll/PayrollWorkspace.svelte",
    "src/lib/payroll/RestaurantPayrollSetup.svelte",
    "src/lib/payroll/EmployeePayrollDetails.svelte",
    "src/lib/payroll/payroll-export.ts",
    "src/lib/payroll/payroll-export-columns.ts",
    "src/lib/schedule/schedule-export.ts",
    "src/lib/schedule/schedule-export-columns.ts",
    "src/lib/operations/RevisionConflictDialog.svelte",
    "src/lib/team/LeaveBalanceSummary.svelte"
  ],
  "ignoreBinaries": ["powershell"],
  "ignoreDependencies": ["@types/web-push", "deno", "npm", "web-push"],
  "ignoreUnresolved": ["^\\$app/", "^\\$env/", "^\\$service-worker$"],
  "exclude": ["types", "exports"]
}
