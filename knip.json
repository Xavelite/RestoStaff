{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/+*.{ts,svelte}",
    "scripts/*.mjs",
    "supabase/functions/*/index.ts",
    "supabase/seed/*.ts",
    "tests/*.test.mjs"
  ],
  "ignore": [
    "src/lib/supabase/database.types.ts"
  ],
  "ignoreBinaries": ["powershell"],
  "ignoreDependencies": ["@types/web-push", "deno", "npm", "web-push"],
  "ignoreUnresolved": ["^\\$app/", "^\\$env/", "^\\$service-worker$"]
}
